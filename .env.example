# ==============================================================================
# NexaVoice Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_NAME=NexaVoice
PORT=4000
API_PREFIX=api/v1
WEB_PORT=3000

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
JWT_SECRET=super-secret-development-jwt-key-replace-in-production-min-32-chars
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Database (PostgreSQL)
DATABASE_URL=postgresql://nexavoice:nexavoice_dev_secret@localhost:5432/nexavoice?schema=public

# Cache & Message Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# GraphQL Configuration
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true

# Logging & Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=nexavoice-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# WebRTC & Media Infrastructure (Signaling Only / SFU Providers)
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
MEDIA_SERVER_PROVIDER=mock
MEDIA_SERVER_ENDPOINT=http://localhost:7880
MEDIA_SERVER_API_KEY=mock-key
MEDIA_SERVER_API_SECRET=mock-secret

# AI Assistant Providers
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage (Object Storage / S3-compatible)
STORAGE_PROVIDER=mock
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=nexavoice-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
