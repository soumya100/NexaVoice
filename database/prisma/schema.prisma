datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountState {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  LOCKED
  DEACTIVATED
  DELETED
}

enum UserStatus {
  ONLINE
  IN_CALL
  BUSY
  AWAY
  OFFLINE
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ContactRelationshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
  REMOVED
}

enum PrivacyLevel {
  EVERYONE
  CONTACTS_ONLY
  NOBODY
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  CALL_EVENT
  AI_EVENT
  SYSTEM
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttachmentStatus {
  PENDING_UPLOAD
  CLEAN
  FLAGGED
  DELETED
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum CallType {
  VOICE
  VIDEO
  CONFERENCE
  PSTN
}

enum CallSessionStatus {
  INITIATING
  RINGING
  CONNECTING
  ACTIVE
  ON_HOLD
  ENDED
  FAILED
  MISSED
  REJECTED
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
  AI_ASSISTANT
}

enum ParticipantState {
  INVITED
  RINGING
  JOINED
  MUTED
  ON_HOLD
  LEFT
  DISCONNECTED
}

enum AIActionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
}

enum SecurityEventResult {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id                   String       @id @default(uuid())
  nexaVoiceId          String       @unique
  username             String       @unique
  email                String?      @unique
  phone                String?      @unique
  passwordHash         String
  displayName          String
  avatarUrl            String?
  status               UserStatus   @default(OFFLINE)
  accountState         AccountState @default(ACTIVE)
  customStatus         String?
  isEmailVerified      Boolean      @default(false)
  isPhoneVerified      Boolean      @default(false)
  tokenVersion         Int          @default(1)
  failedLoginAttempts  Int          @default(0)
  lockoutUntil         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  sessions             Session[]
  devices              Device[]
  roleAssignments      UserRoleAssignment[]
  sentMessages         Message[]                 @relation("UserSentMessages")
  conversations        ConversationParticipant[]
  callParticipants     CallParticipant[]
  aiProfile            AIProfile?
  aiActions            AIAction[]
  consentRecords       ConsentRecord[]
  auditEvents          AuditEvent[]
  securityEvents       SecurityEvent[]
  privacySettings      UserPrivacySettings?

  sentContactRequests     ContactRelationship[] @relation("SentContactRequests")
  receivedContactRequests ContactRelationship[] @relation("ReceivedContactRequests")
  blockedUsers            BlockedUser[]         @relation("UserBlocks")
  blockedByUsers          BlockedUser[]         @relation("BlockedByUsers")
  reactions               MessageReaction[]
  attachments             Attachment[]
  filedReports            MessageReport[]       @relation("FiledReports")

  @@index([username])
  @@index([nexaVoiceId])
  @@index([email])
  @@index([accountState])
}

model UserPrivacySettings {
  id                        String       @id @default(uuid())
  userId                    String       @unique
  discoverableByNexaVoiceId Boolean      @default(true)
  discoverableByUsername    Boolean      @default(true)
  discoverableByEmail       Boolean      @default(false)
  discoverableByPhone       Boolean      @default(false)
  whoCanMessageMe           PrivacyLevel @default(EVERYONE)
  whoCanAddMeToGroups       PrivacyLevel @default(EVERYONE)
  readReceiptsEnabled       Boolean      @default(true)
  typingIndicatorsEnabled   Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactRelationship {
  id           String                    @id @default(uuid())
  requesterId  String
  recipientId  String
  status       ContactRelationshipStatus @default(PENDING)
  nickname     String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  acceptedAt   DateTime?
  blockedAt    DateTime?

  requester User @relation("SentContactRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedContactRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Conversation {
  id              String           @id @default(uuid())
  type            ConversationType @default(DIRECT)
  title           String?
  description     String?
  avatarUrl       String?
  creatorId       String?
  directUserAId   String?
  directUserBId   String?
  currentSequence Int              @default(0)
  lastMessageAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  calls        CallSession[]

  @@unique([directUserAId, directUserBId])
  @@index([type])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id                      String           @id @default(uuid())
  conversationId          String
  userId                  String
  role                    ParticipantRole  @default(PARTICIPANT)
  conversationRole        ConversationRole @default(MEMBER)
  joinedAt                DateTime         @default(now())
  lastDeliveredMessageId  String?
  lastReadMessageId       String?
  lastReadAt              DateTime?
  isMuted                 Boolean          @default(false)
  muteUntil               DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id                String                @id @default(uuid())
  conversationId    String
  senderId          String
  clientMessageId   String?
  sequenceNumber    Int                   @default(0)
  type              MessageType           @default(TEXT)
  content           String
  replyToMessageId  String?
  deliveryStatus    MessageDeliveryStatus @default(PENDING)
  isEdited          Boolean               @default(false)
  editedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  attachments  Attachment[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, sequenceNumber])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, reaction])
  @@index([messageId])
}

model Attachment {
  id              String           @id @default(uuid())
  uploaderId      String
  messageId       String?
  objectKey       String           @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksumSha256  String?
  status          AttachmentStatus @default(CLEAN)
  voiceDurationMs Int?
  voiceFormat     String?
  createdAt       DateTime         @default(now())

  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([messageId])
}

model MessageReport {
  id             String       @id @default(uuid())
  reporterId     String
  messageId      String?
  reportedUserId String?
  reason         String
  description    String?
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())

  reporter User @relation("FiledReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([name])
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([action])
  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRoleAssignment {
  userId     String
  roleId     String
  assignedBy String?
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

model Session {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  replacedByTokenHash String?
  deviceId            String?
  expiresAt           DateTime
  isRevoked           Boolean   @default(false)
  revocationReason    String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime  @default(now())
  lastActiveAt        DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([replacedByTokenHash])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String   @unique
  deviceType   String   // WEB, IOS, ANDROID, DESKTOP
  deviceName   String
  platform     String?
  appVersion   String?
  isTrusted    Boolean  @default(false)
  pushToken    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
}

model CallSession {
  id             String            @id @default(uuid())
  conversationId String?
  callType       CallType          @default(VOICE)
  status         CallSessionStatus @default(INITIATING)
  hostUserId     String
  startedAt      DateTime          @default(now())
  endedAt        DateTime?

  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants CallParticipant[]

  @@index([status])
  @@index([hostUserId])
}

model CallParticipant {
  id            String           @id @default(uuid())
  callSessionId String
  userId        String
  role          ParticipantRole  @default(PARTICIPANT)
  state         ParticipantState @default(INVITED)
  isAudioMuted  Boolean          @default(false)
  isVideoMuted  Boolean          @default(false)
  joinedAt      DateTime         @default(now())
  leftAt        DateTime?

  callSession CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callSessionId, userId])
  @@index([callSessionId])
  @@index([userId])
}

model AIProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  name                   String   @default("Nexa")
  avatarUrl              String?
  voiceStyle             String   @default("Friendly Neutral")
  personality            String   @default("Helpful, Concise, Professional")
  language               String   @default("en-US")
  autoScreeningEnabled   Boolean  @default(false)
  canSpeakInCalls        Boolean  @default(false)
  canSummarizeRecordings Boolean  @default(true)
  createdAt              DateTime @default(now())

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedPermissions AIPermissionAssignment[]
}

model AIPermissionAssignment {
  id               String   @id @default(uuid())
  aiProfileId      String
  permissionAction String
  granted          Boolean  @default(false)
  requiresApproval Boolean  @default(true)
  grantedAt        DateTime @default(now())

  aiProfile AIProfile @relation(fields: [aiProfileId], references: [id], onDelete: Cascade)

  @@unique([aiProfileId, permissionAction])
  @@index([aiProfileId])
}

model AIAction {
  id                     String                 @id @default(uuid())
  userId                 String
  actionType             String
  description            String
  confidenceScore        Float                  @default(1.0)
  requiresHumanApproval  Boolean                @default(false)
  status                 AIActionApprovalStatus @default(AUTO_APPROVED)
  payloadJson            String                 @default("{}")
  createdAt              DateTime               @default(now())
  executedAt             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ConsentRecord {
  id           String   @id @default(uuid())
  userId       String
  consentType  String
  version      String
  granted      Boolean
  jurisdiction String   @default("GLOBAL")
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   String   @default("{}")
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model SecurityEvent {
  id            String              @id @default(uuid())
  actorId       String?
  action        String
  targetType    String?
  targetId      String?
  result        SecurityEventResult @default(SUCCESS)
  reason        String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  metadataJson  String              @default("{}")
  createdAt     DateTime            @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([result])
}
