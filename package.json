{
  "name": "nexavoice-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NexaVoice — Global General-Purpose Communication Platform with Integrated Personal AI Assistant",
  "workspaces": [
    "packages/*",
    "backend/apps/*",
    "backend/libs/*",
    "apps/*",
    "database"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docker:dev": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "prisma:generate": "prisma generate --schema=database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=database/prisma/schema.prisma",
    "start:api": "npm run start:dev --workspace=@nexavoice/api",
    "start:web": "npm run dev --workspace=@nexavoice/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}